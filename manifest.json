{
  "manifest_version": 3,
  "name": "Tel2QR",
  "version": "1.0.0",
  "description": "Click any tel: link to see a QR code you can scan with your phone",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
