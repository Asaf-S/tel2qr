{
  "name": "tel2qr",
  "version": "1.0.0",
  "description": "Chrome extension: click a tel: link to get a scannable QR code",
  "scripts": {
    "build": "esbuild src/content.ts src/background.ts src/popup.ts src/handler.ts --bundle --outdir=dist --platform=browser --target=chrome100 --minify",
    "dev": "esbuild src/content.ts src/background.ts src/popup.ts src/handler.ts --bundle --outdir=dist --platform=browser --target=chrome100 --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:debug": "npm run build && node --inspect-brk ./node_modules/.bin/playwright test --timeout=0",
    "package": "npm run build && mkdir -p releases && zip -r releases/tel2qr-v$(node -p \"require('./manifest.json').version\").zip manifest.json dist/ icons/ popup.html handler.html",
    "upload": "dotenv -e .env -- chrome-webstore-upload upload --source releases/tel2qr-v$(node -p \"require('./manifest.json').version\").zip",
    "release": "npm run package && npm run upload"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asaf-S/tel2qr.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Asaf-S/tel2qr/issues"
  },
  "homepage": "https://github.com/Asaf-S/tel2qr#readme",
  "dependencies": {
    "libphonenumber-js": "^1.13.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.42",
    "@types/qrcode": "^1.5.6",
    "chrome-webstore-upload-cli": "^4.0.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
